{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "tests",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "playwright.config.ts",
    "vitest.config.ts",
    "scripts/delivery-financial-ssot-runtime-close.ts"
  ]
}
