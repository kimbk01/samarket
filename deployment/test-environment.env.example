# DIBAY TEST — Vercel Custom Environment `test` (not Production, not shared Preview).
# Never put Production secrets here. Do NOT "Import from Production".
#
# Confirmed Owner project ref (2026-10-14): tcwnueuzuxftyomttdyu
# VERCEL_ENV on custom env remains "preview"; VERCEL_TARGET_ENV becomes "test".

NEXT_PUBLIC_APP_DEPLOY_TIER=staging
NEXT_PUBLIC_APP_NAME=DIBAY TEST

# REQUIRED: must NOT be https://ckdosyydvgzqwpbwuhon.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://tcwnueuzuxftyomttdyu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_TEST_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_TEST_SERVICE_ROLE_KEY

# Distinct from Production (TEST-only CRON_SECRET)
CRON_SECRET=YOUR_TEST_CRON_SECRET

# Keep 0 until TEST FCM/APNs projects are wired (P2+)
PUSH_DISPATCH_ENABLED=0
WEB_PUSH_ENABLED=0

# P1 allowlist (required on TEST surface — empty deny-all)
NEXT_PUBLIC_DIBAY_RUNTIME_SURFACE=test
DIBAY_TEST_ALLOWED_USER_IDS=
DIBAY_TEST_ALLOWED_EMAILS=

# Do NOT copy onto `test` until dedicated TEST projects exist:
# COMMUNITY_MESSENGER_AGORA_* · FCM_* · APNS_* · SEMAPHORE_* (Production keys = isolation FAIL)

# Native (P2): com.dibay.app.test / DIBAY TEST
# DIBAY_NATIVE_FLAVOR=test
# CAPACITOR_SERVER_URL=https://your-test-host.example

# Admin Web promote (ops host only — never expose token to public client)
# DIBAY_PROMOTE_ENABLED=1
# DIBAY_PROMOTE_GITHUB_TOKEN=
# DIBAY_PROMOTE_GITHUB_REPO=kimbk01/samarket
# DIBAY_PROMOTE_GITHUB_REF=main
