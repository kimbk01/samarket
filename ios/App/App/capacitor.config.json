{
	"appId": "com.dibay.app",
	"appName": "DIBAY",
	"webDir": "capacitor-www",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"SplashScreen": {
			"launchAutoHide": false,
			"launchShowDuration": 0,
			"backgroundColor": "#FFFCFC",
			"androidSplashResourceName": "splash"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"PushNotificationsPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"BadgePlugin"
	]
}
