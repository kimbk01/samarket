# Cursor indexing / AI context exclusions — reduce memory & embeddable scan load.
# Does not affect app runtime or git. See Cursor ignore-file docs.

node_modules/
.next/
.next-*/
dist/
build/
coverage/
.turbo/
.vercel/
.tsbuild/
*.tsbuildinfo

android/app/build/
android/.gradle/
ios/build/
ios/DerivedData/

# Accidental nested path dumps + ephemeral QA outputs (root-anchored .tmp)
Users/
/.tmp-*/
/.tmp-*
docs/perf/**/*.apk

# Agent needs git access (do not ignore .git/)
.qa-logs/
.worktrees/
