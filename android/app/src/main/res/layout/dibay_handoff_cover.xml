<?xml version="1.0" encoding="utf-8"?>
<!--
  Handoff cover — ZERO: solid app-shell WHITE only.
  No logo / brand wordmark / nav silhouette (R14 residual removed).
  Error/retry panel kept for remote-load failure only (visibility=gone by default).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dibay_handoff_cover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFCFC"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Kept for MainActivity findViewById; invisible / unused on ZERO cold path. -->
    <ImageView
        android:id="@+id/dibay_handoff_cover_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/dibay_handoff_cover_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dibay_handoff_cover_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#5C6B63"
            android:textSize="14sp" />

        <Button
            android:id="@+id/dibay_handoff_cover_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="다시 시도" />
    </LinearLayout>
</FrameLayout>
