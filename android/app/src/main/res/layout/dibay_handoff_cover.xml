<?xml version="1.0" encoding="utf-8"?>
<!-- Local→Remote handoff cover — cream + DIBAY logo + bottom nav silhouette. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dibay_handoff_cover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFCFC"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header silhouette -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF"
            android:elevation="1dp">
            <View
                android:layout_width="96dp"
                android:layout_height="14dp"
                android:background="#E6EBE8" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E6EBE8" />

        <!-- Body: centered logo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFCFC">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/dibay_handoff_cover_logo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dibay_splash_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.08"
                    android:text="DIBAY"
                    android:textColor="#0B421A"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Error / retry (visible only on remote load failure while cover is up) -->
            <LinearLayout
                android:id="@+id/dibay_handoff_cover_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="88dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/dibay_handoff_cover_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#5C6B63"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/dibay_handoff_cover_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="다시 시도" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E6EBE8" />

        <!-- Bottom nav silhouette -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="6dp"
            android:paddingTop="6dp">

            <View
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="#E6EBE8" />
            <View
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="#E6EBE8" />
            <View
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="#E6EBE8" />
            <View
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="#E6EBE8" />
            <View
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="#E6EBE8" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
