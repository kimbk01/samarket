<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_call_dock_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dibay_incoming_pill"
    android:clickable="true"
    android:elevation="32dp"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/native_call_dock_avatar_initial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_dibay_incoming_avatar"
        android:gravity="center"
        android:textColor="@color/dibay_incoming_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/native_call_dock_peer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dibay_incoming_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/native_call_dock_media_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/dibay_incoming_video_brand"
                android:src="@android:drawable/presence_video_online"
                android:tint="@color/dibay_incoming_text_muted" />

            <TextView
                android:id="@+id/native_call_dock_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/dibay_incoming_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/native_call_dock_resume"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_dibay_incoming_btn_accept"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/dibay_call_dock_resume"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

    <Button
        android:id="@+id/native_call_dock_end"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_dibay_incoming_btn_reject"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/dibay_video_call_end"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="12sp" />
</LinearLayout>
