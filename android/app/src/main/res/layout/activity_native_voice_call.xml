<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_voice_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dibay_incoming_fullscreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/dibay_call_avatar_lg"
                android:layout_height="@dimen/dibay_call_avatar_lg">

                <TextView
                    android:id="@+id/native_voice_call_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dibay_incoming_avatar"
                    android:gravity="center"
                    android:textColor="@color/dibay_call_primary_pressed"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/native_voice_call_peer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_primary"
                android:textSize="@dimen/dibay_incoming_name_sp_full"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/native_voice_call_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_muted"
                android:textSize="@dimen/dibay_incoming_status_sp" />

            <TextView
                android:id="@+id/native_voice_call_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dibay_call_btn_gap"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_primary"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_voice_call_incoming_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dibay_call_incoming_btn_gap"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/native_voice_call_decline"
                    android:layout_width="@dimen/dibay_call_btn_size_max"
                    android:layout_height="@dimen/dibay_call_btn_size_max"
                    android:background="@drawable/bg_call_control_danger"
                    android:contentDescription="@string/dibay_incoming_reject"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_end_x" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/dibay_incoming_reject"
                    android:textColor="@color/dibay_incoming_text_primary"
                    android:textSize="@dimen/dibay_call_control_label_sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dibay_call_incoming_btn_gap"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/native_voice_call_accept"
                    android:layout_width="@dimen/dibay_call_btn_size_max"
                    android:layout_height="@dimen/dibay_call_btn_size_max"
                    android:background="@drawable/bg_call_control_accept"
                    android:contentDescription="@string/dibay_incoming_accept"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_check" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/dibay_incoming_accept"
                    android:textColor="@color/dibay_incoming_text_primary"
                    android:textSize="@dimen/dibay_call_control_label_sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_voice_call_media_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/native_voice_call_speaker"
                    android:layout_width="@dimen/dibay_call_btn_size_default"
                    android:layout_height="@dimen/dibay_call_btn_size_default"
                    android:background="@drawable/bg_call_control_neutral"
                    android:contentDescription="@string/dibay_call_control_speaker"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_speaker_off" />

                <TextView
                    android:id="@+id/native_voice_call_speaker_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/dibay_call_control_speaker"
                    android:textColor="@color/dibay_incoming_text_primary"
                    android:textSize="@dimen/dibay_call_control_label_sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/native_voice_call_video"
                    android:layout_width="@dimen/dibay_call_btn_size_default"
                    android:layout_height="@dimen/dibay_call_btn_size_default"
                    android:background="@drawable/bg_call_control_neutral"
                    android:contentDescription="@string/dibay_call_control_video"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_video" />

                <TextView
                    android:id="@+id/native_voice_call_video_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/dibay_call_control_video"
                    android:textColor="@color/dibay_incoming_text_primary"
                    android:textSize="@dimen/dibay_call_control_label_sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/native_voice_call_mute"
                    android:layout_width="@dimen/dibay_call_btn_size_default"
                    android:layout_height="@dimen/dibay_call_btn_size_default"
                    android:background="@drawable/bg_call_control_neutral"
                    android:contentDescription="@string/dibay_call_control_mute"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_mic_off" />

                <TextView
                    android:id="@+id/native_voice_call_mute_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/dibay_call_control_mute"
                    android:textColor="@color/dibay_incoming_text_primary"
                    android:textSize="@dimen/dibay_call_control_label_sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/native_voice_call_end"
                    android:layout_width="@dimen/dibay_call_btn_size_default"
                    android:layout_height="@dimen/dibay_call_btn_size_default"
                    android:background="@drawable/bg_call_control_danger"
                    android:contentDescription="@string/dibay_voice_call_end"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_end_x" />

                <TextView
                    android:id="@+id/native_voice_call_end_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/dibay_voice_call_end"
                    android:textColor="@color/dibay_incoming_text_primary"
                    android:textSize="@dimen/dibay_call_control_label_sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
