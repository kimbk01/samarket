<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_voice_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dibay_incoming_fullscreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/dibay_incoming_avatar_full"
                android:layout_height="@dimen/dibay_incoming_avatar_full">

                <TextView
                    android:id="@+id/native_voice_call_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dibay_incoming_avatar"
                    android:gravity="center"
                    android:textColor="@color/dibay_incoming_primary"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/native_voice_call_peer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_primary"
                android:textSize="@dimen/dibay_incoming_name_sp_full"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/native_voice_call_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_muted"
                android:textSize="@dimen/dibay_incoming_status_sp" />

            <TextView
                android:id="@+id/native_voice_call_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_primary"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_voice_call_incoming_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/native_voice_call_decline"
                android:layout_width="@dimen/dibay_incoming_btn_circle_full"
                android:layout_height="@dimen/dibay_incoming_btn_circle_full"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_dibay_incoming_btn_reject"
                android:contentDescription="@string/dibay_incoming_reject"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/native_voice_call_accept"
                android:layout_width="@dimen/dibay_incoming_btn_circle_full"
                android:layout_height="@dimen/dibay_incoming_btn_circle_full"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_dibay_incoming_btn_accept"
                android:contentDescription="@string/dibay_incoming_accept"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/sym_action_call"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_voice_call_active_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <Button
                android:id="@+id/native_voice_call_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dibay_incoming_btn_reject"
                android:minWidth="160dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/dibay_voice_call_end"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <LinearLayout
                android:id="@+id/native_voice_call_connected_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/native_voice_call_speaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_dibay_incoming_btn_accept"
                    android:minWidth="120dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/dibay_voice_speaker_off"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
