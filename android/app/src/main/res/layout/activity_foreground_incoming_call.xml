<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/foreground_incoming_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/foreground_incoming_pill_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/dibay_incoming_pill_margin_h"
        android:paddingEnd="@dimen/dibay_incoming_pill_margin_h">

        <LinearLayout
            android:id="@+id/foreground_incoming_pill"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dibay_incoming_pill_height"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_dibay_incoming_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxWidth="@dimen/dibay_incoming_pill_max_width"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="@dimen/dibay_incoming_avatar_pill"
                android:layout_height="@dimen/dibay_incoming_avatar_pill"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/foreground_incoming_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dibay_incoming_avatar"
                    android:contentDescription="@string/dibay_incoming_default_caller"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/foreground_incoming_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/dibay_incoming_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/foreground_incoming_caller_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dibay_incoming_text_primary"
                    android:textSize="@dimen/dibay_incoming_name_sp_pill"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foreground_incoming_kind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dibay_incoming_text_muted"
                    android:textSize="@dimen/dibay_incoming_status_sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/foreground_incoming_decline"
                android:layout_width="@dimen/dibay_incoming_btn_circle"
                android:layout_height="@dimen/dibay_incoming_btn_circle"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dibay_incoming_btn_reject"
                android:contentDescription="@string/dibay_incoming_reject"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_dibay_incoming_reject" />

            <ImageButton
                android:id="@+id/foreground_incoming_accept"
                android:layout_width="@dimen/dibay_incoming_btn_circle"
                android:layout_height="@dimen/dibay_incoming_btn_circle"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dibay_incoming_btn_accept"
                android:contentDescription="@string/dibay_incoming_accept"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_dibay_incoming_accept" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
