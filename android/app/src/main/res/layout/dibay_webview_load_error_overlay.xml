<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dibay_webview_load_error_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dibay_webview_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dibay_webview_error_title"
            android:textColor="#1A2E28"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dibay_webview_error_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/dibay_webview_error_body"
            android:textColor="#4A5F58"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dibay_webview_error_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="#7A8F88"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/dibay_webview_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minWidth="160dp"
            android:text="@string/dibay_webview_error_retry" />
    </LinearLayout>
</FrameLayout>
