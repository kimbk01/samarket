<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_video_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dibay_call_dark_bg">

    <FrameLayout
        android:id="@+id/native_video_call_video_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/native_video_call_remote"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dibay_call_dark_bg" />

        <FrameLayout
            android:id="@+id/native_video_call_local"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="88dp"
            android:layout_marginEnd="20dp"
            android:background="@color/dibay_call_dark_card"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/native_video_call_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dibay_incoming_fullscreen"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/native_video_call_status_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/dibay_call_avatar_lg"
                android:layout_height="@dimen/dibay_call_avatar_lg">

                <TextView
                    android:id="@+id/native_video_call_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dibay_incoming_avatar"
                    android:gravity="center"
                    android:textColor="@color/dibay_call_primary_pressed"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/native_video_call_peer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_primary"
                android:textSize="@dimen/dibay_incoming_name_sp_full"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/native_video_call_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_muted"
                android:textSize="@dimen/dibay_incoming_status_sp" />

            <TextView
                android:id="@+id/native_video_call_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dibay_call_btn_gap"
                android:gravity="center"
                android:textColor="@color/dibay_incoming_text_primary"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_video_call_incoming_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/native_video_call_decline"
                android:layout_width="@dimen/dibay_call_btn_size_max"
                android:layout_height="@dimen/dibay_call_btn_size_max"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_dibay_incoming_btn_reject"
                android:contentDescription="@string/dibay_incoming_reject"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/native_video_call_accept"
                android:layout_width="@dimen/dibay_call_btn_size_max"
                android:layout_height="@dimen/dibay_call_btn_size_max"
                android:layout_marginStart="40dp"
                android:background="@drawable/bg_dibay_incoming_btn_accept"
                android:contentDescription="@string/dibay_incoming_accept"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/sym_action_call"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/native_video_call_active_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:elevation="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <Button
            android:id="@+id/native_video_call_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dibay_incoming_btn_reject"
            android:minHeight="@dimen/dibay_call_touch_min"
            android:minWidth="160dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/dibay_video_call_end"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/native_video_call_connected_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dibay_call_btn_gap"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/native_video_call_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dibay_incoming_btn_accept"
                android:minHeight="@dimen/dibay_call_touch_min"
                android:minWidth="@dimen/dibay_call_btn_size_min"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/dibay_video_camera_on"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
