<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dibay_incoming_deep_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="165"
                android:startColor="@color/dibay_incoming_gradient_start"
                android:centerColor="@color/dibay_incoming_gradient_mid"
                android:endColor="@color/dibay_incoming_gradient_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/dibay_incoming_green_wash"
                android:centerColor="#00000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
