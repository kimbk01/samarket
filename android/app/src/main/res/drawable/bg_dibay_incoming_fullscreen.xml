<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dibay_incoming_deep_green" />
        </shape>
    </item>
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/dibay_incoming_green_wash"
                android:centerColor="@color/dibay_incoming_surface_dark"
                android:endColor="@color/dibay_incoming_deep_green"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
