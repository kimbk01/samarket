<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 다크 모드 없음 (Owner 2026-11-12) — Light 고정: isLightTheme=true → WebView prefers-color-scheme 항상 light -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
      R17-OS — TRUE Android OS SplashScreen: dibaY background + centered static logo.
      Build-time resources only. Held by MainActivity until the existing web visual fence.
      No Intro / System Start / product start screen.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/dibay_app_bg</item>
        <item name="android:windowBackground">@color/dibay_app_bg</item>
        <!-- androidx.core SplashScreen attrs -->
        <item name="windowSplashScreenBackground">@color/dibay_os_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_os_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/dibay_os_bg</item>
        <!-- Android 12+ platform attrs (Samsung starting-window path) -->
        <item name="android:windowSplashScreenBackground">@color/dibay_os_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_os_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/dibay_os_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- 다크 모드 없음 (Owner 2026-11-12 「통화 포함 진행」) — 통화 화면도 Light 고정 -->
    <style name="AppTheme.IncomingCall" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/dibay_incoming_deep_green</item>
        <!-- 다크 모드 없음 (Owner 2026-11-13) — Android 강제 다크(개발자 옵션·제조사 기능) 대상에서 제외 -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="AppTheme.ForegroundIncomingCall" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <!-- 다크 모드 없음 (Owner 2026-11-13) — Android 강제 다크(개발자 옵션·제조사 기능) 대상에서 제외 -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>