{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "ignoreCommand": "node scripts/vercel-ignored-build-step.mjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "*/*": false,
      "*/*/*": false,
      "claude/**": false,
      "feat/**": false,
      "chore/**": false,
      "fix/**": false,
      "cursor/**": false,
      "dibay-*": false
    }
  },
  "env": {
    "SAMARKET_PROD_PERF_MEASURE": "1",
    "NEXT_PUBLIC_SAMARKET_PROD_PERF_MEASURE": "1",
    "OWNER_DASHBOARD_PERF_ENV": "prod_same_region",
    "SUPABASE_REGION": "ap-south-1"
  },
  "crons": [
    {
      "path": "/api/cron/notification-campaigns-dispatch-scheduled",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/commerce-notification-push-handoff",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/delivery-ads-schedule-transitions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/community-messenger/calls/sessions/stale-cleanup",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/notification-push-handoff",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/community-import-collect",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/community-import-publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/store-currency-recognition-reconcile",
      "schedule": "17 */6 * * *"
    },
    {
      "path": "/api/cron/admin-notification-delivery",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/stores-discovery-schedule-transitions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/stores-discovery-popularity-expire",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/stores-discovery-coverage-rebuild",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/trade-promotion-orders-expire",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/store-orders-auto-complete",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/store-order-accept-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/store-orders-accept-timeout",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/store-orders-sla-scan",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/store-product-images-orphan-gc",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/community-post-images-gc",
      "schedule": "50 19 * * *"
    }
  ]
}
