# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
.eslint-errors.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Apple Sign In private keys (never commit)
*.p8
AuthKey_*.p8

# Local temp media extracts
.tmp-video-frames/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 백업/복사본 이름 (_env.local 등) — .env* 에는 매칭되지 않음
_env.local
_env*.local

# Kakao Native App Key — local iOS build only (never commit)
ios/App/App/Kakao.local.xcconfig

# Android SDK path + local secrets (never commit)
android/local.properties

# vercel
.vercel

# DIBAY perf QA artifacts — device/local only (Vercel serverless 한도 초과 방지)
docs/perf/**/*.apk
docs/perf/qa-safe-area/

# local dev junk (curl dumps, pid files)
/_curl_body.txt
/_dev*.pid

# dev benchmark tee logs (see docs/dev-runtime-benchmark-protocol.md)
/benchmark-runs/

# R2-D1 Supabase dashboard login profile (local only)
.playwright-supabase-profile/

# typescript
*.tsbuildinfo
next-env.d.ts
.idea/
